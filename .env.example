SECRET_KEY=change-me-to-a-random-64-byte-hex-string
DATABASE_URL=postgresql://postgres:password@localhost:5432/coachprash
FLASK_ENV=development
ADMIN_EMAIL=admin@coachprash.com
ADMIN_PASSWORD=change-me-use-a-strong-password
STEALTH_CODE=change-me

# Google Sign-In (required for OAuth login)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Railway Storage Bucket (required for image uploads)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
RAILWAY_BUCKET_ENDPOINT=your-endpoint
RAILWAY_BUCKET_NAME=your-bucket-name

# Local-only: Google Workspace CLI (NOT needed on Railway)
# GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id
# GOOGLE_OAUTH_CLIENT_SECRET=your-oauth-client-secret
